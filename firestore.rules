rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection (Created strictly via /api/register with Firebase Admin)
    match /users/{userId} {
      // User can read their own profile
      allow read: if request.auth != null && request.auth.uid == userId;

      // CLIENT-SIDE CREATION IS STRICTLY FORBIDDEN to eliminate privilege escalation
      // User accounts must be created authoritatively via /api/register
      allow create: if false;

      // Updates from client cannot modify sensitive fields (credits, role, isBlocked, etc.)
      allow update: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny([
                          'credits',
                          'role',
                          'isAdmin',
                          'isBlocked',
                          'antiFraudScore',
                          'mfaEnabled',
                          'deviceFingerprint',
                          'promotionalCreditsBlocked',
                          'fraudReasons',
                          'lastPlanId',
                          'fullName',
                          'birthDate',
                          'birthTime'
                        ]);

      allow delete: if false; // Deletion handled server-side under LGPD via /api/account
    }

    // Permanent Spiritual Profiles (Owner read-only, write server-only)
    match /spiritual_profiles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Living Spiritual History (Owner read-only, write server-only)
    match /spiritual_history/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Readings Collection (Server Authoritative - Client CANNOT WRITE)
    match /readings/{readingId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false; // Only server can write immutable readings
    }

    // Credit Ledger (Server Authoritative - Client CANNOT WRITE)
    match /credit_ledger/{ledgerId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false; // Immutable, server/admin only
    }

    // Payment Orders (Client CANNOT WRITE)
    match /payment_orders/{orderId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Credit Operations / Idempotency records (Server only)
    match /credit_operations/{opId} {
      allow read, write: if false;
    }

    // Diary Entries (Private to owner)
    match /diary/{entryId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
    }

    // Security Logs (Admin / Server only)
    match /security_logs/{logId} {
      allow read, write: if false;
    }

    // Distributed Rate Limits (Server only)
    match /rate_limits/{bucketId} {
      allow read, write: if false;
    }
  }
}
